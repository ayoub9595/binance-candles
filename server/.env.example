PORT=4000
MONGODB_URI=mongodb://admin:changeme@localhost:27017
DB_NAME=binance_candles
CORS_ORIGIN=http://localhost:5173
# PAXGUSDT (PAX Gold, 1 token = 1 troy oz) stands in for gold: Binance does
# not list XAUUSD — spot gold is a forex/CFD instrument, not a crypto pair.
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,PAXGUSDT
BINANCE_INTERVALS=15m,1h,4h
BACKFILL_LIMIT=1000
