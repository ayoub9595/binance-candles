PORT=4000
MONGODB_URI=mongodb://admin:changeme@localhost:27017
DB_NAME=binance_candles
CORS_ORIGIN=http://localhost:5173
# PAXGUSDT (PAX Gold, 1 token = 1 troy oz) is Binance's gold token: Binance
# does not list XAUUSD — spot gold is a forex/CFD instrument, not a crypto pair.
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,PAXGUSDT
BINANCE_INTERVALS=15m,1h,4h
# Real forex instruments, ingested from Deriv's public API instead of Binance.
# Only symbols defined in src/services/forexInstruments.js are supported.
FOREX_SYMBOLS=XAUUSD
# Optional: your own Deriv app id (api.deriv.com); defaults to the public 1089.
#DERIV_APP_ID=1089
BACKFILL_LIMIT=1000
