PORT=4000
MONGODB_URI=mongodb://admin:changeme@localhost:27017
DB_NAME=binance_candles
CORS_ORIGIN=http://localhost:5173
# PAXGUSDT (PAX Gold, 1 token = 1 troy oz) is Binance's gold token: Binance
# does not list XAUUSD — spot gold is a forex/CFD instrument, not a crypto pair.
BINANCE_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,PAXGUSDT
BINANCE_INTERVALS=1m,3m,5m,15m,30m,1h,4h
# Real forex instruments, ingested from the forex provider instead of Binance.
# Only symbols defined in src/services/forexInstruments.js are supported.
FOREX_SYMBOLS=XAUUSD
# Which upstream serves them: "deriv" (public API, keyless, default) or
# "ctrader" — your broker's own feed over the cTrader Open API, so XAUUSD
# matches what e.g. Fusion Markets' cTrader charts show.
FOREX_PROVIDER=deriv
# Optional: your own Deriv app id (api.deriv.com); defaults to the public 1089.
#DERIV_APP_ID=1089
# --- FOREX_PROVIDER=ctrader credentials --------------------------------------
# 1. Open a cTrader account at your broker (a Fusion Markets demo is fine).
# 2. Register an application at https://openapi.ctrader.com (any redirect URL
#    works for the playground flow) — that gives the client id and secret.
# 3. Use the site's Playground to authorize the app against your cTID and get
#    an access token (and a refresh token, which lets the server renew the
#    access token by itself when it expires).
# CTRADER_HOST_TYPE is "demo" or "live" — match the account the token covers.
# CTRADER_ACCOUNT_ID (the ctidTraderAccountId) is optional; when unset the
# server picks the token's first account of the matching host type and logs it.
#CTRADER_HOST_TYPE=demo
#CTRADER_CLIENT_ID=
#CTRADER_CLIENT_SECRET=
#CTRADER_ACCESS_TOKEN=
#CTRADER_REFRESH_TOKEN=
#CTRADER_ACCOUNT_ID=
BACKFILL_LIMIT=1000
